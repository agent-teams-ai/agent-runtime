{
  "name": "@agent-teams/interactive-provider-contract-experiment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25 || >=26.11.1 <27"
  },
  "description": "TEST compatibility consumer of the canonical runtime SPI and workspace Claude implementation",
  "exports": {
    "./draft-contracts": {
      "types": "./dist/draft-contracts/index.d.ts",
      "import": "./dist/draft-contracts/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter '@agent-teams/interactive-provider-contract-experiment^...' -r run build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/session.test.ts test/failures.test.ts test/fixture-host.test.ts test/live-preflight.test.ts",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "test:sdk-process": "node --test test/sdk-process.e2e.test.ts",
    "test:packed": "pnpm build && node --test test/packed-consumer.test.ts",
    "harness": "node harness/live.ts"
  },
  "dependencies": {
    "@agent-teams/provider-implementations": "workspace:*",
    "@agent-teams/agent-execution": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:provider-implementations",
    "zod": "catalog:provider-implementations"
  }
}
