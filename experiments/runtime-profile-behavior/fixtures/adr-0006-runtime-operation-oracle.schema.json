{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adr-0006-runtime-operation-oracle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "adr", "cases"],
  "properties": {
    "$schema": { "const": "./adr-0006-runtime-operation-oracle.schema.json" },
    "schemaVersion": { "const": 1 },
    "adr": { "const": "ADR-0006" },
    "cases": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "canonicalId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "examples"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "requirement": { "type": "integer", "minimum": 1, "maximum": 28 },
        "examples": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/example" }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "facts", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "check": { "$ref": "#/$defs/check" },
        "facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fact" }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "code"],
          "properties": {
            "decision": { "enum": ["accept", "reject"] },
            "code": { "$ref": "#/$defs/resultCode" }
          }
        }
      }
    },
