{
  "name": "@agent-teams/provider-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json --pretty false",
    "check": "pnpm run clean && pnpm run typecheck && pnpm run build && pnpm run test",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','.cache']) fs.rmSync(path, { recursive: true, force: true })\"",
    "test": "node --test --test-concurrency=1 tests/features/contained-turn-access/*.test.ts",
    "test:postgres": "node --import ./scripts/require-postgres-qualification.mjs --test --test-concurrency=1 tests/features/contained-turn-access/postgres-materialization-durability.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "test:postgres:dispatch": "node --import ./scripts/require-postgres-qualification.mjs --test --test-concurrency=1 tests/features/contained-turn-access/postgres-dispatch-durability.test.ts",
    "test:postgres:operation-dispatch": "node --import ./scripts/require-postgres-qualification.mjs --test --test-concurrency=1 tests/features/contained-turn-access/postgres-operation-dispatch-durability.test.ts"
  },
  "agentTeamsArchitecture": {
    "role": "bounded-context",
    "ownerDocument": "ADR-0005"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./tests/features/contained-turn-access/credential-rendering-test-fixture.ts": "./tests/features/contained-turn-access/credential-rendering-test-fixture.ts",
    "./tests/features/contained-turn-access/operation-dispatch-test-fixture.ts": "./tests/features/contained-turn-access/operation-dispatch-test-fixture.ts",
    "./tests/features/contained-turn-access/postgres-materialization-url.fixtures.ts": "./tests/features/contained-turn-access/postgres-materialization-url.fixtures.ts",
    "./tests/features/contained-turn-access/route-selection-fixture.ts": "./tests/features/contained-turn-access/route-selection-fixture.ts",
    "./dist/features/contained-turn-access/adapters/outbound/credential-rendering-contracts.js": "./dist/features/contained-turn-access/adapters/outbound/credential-rendering-contracts.js",
    "./dist/features/contained-turn-access/adapters/outbound/postgres/dispatch-operation-schema.js": "./dist/features/contained-turn-access/adapters/outbound/postgres/dispatch-operation-schema.js",
    "./dist/features/contained-turn-access/adapters/outbound/postgres/materialization-postgres-repository.js": "./dist/features/contained-turn-access/adapters/outbound/postgres/materialization-postgres-repository.js",
    "./dist/features/contained-turn-access/adapters/outbound/postgres/materialization-postgres-schema.js": "./dist/features/contained-turn-access/adapters/outbound/postgres/materialization-postgres-schema.js",
    "./dist/features/contained-turn-access/adapters/outbound/postgres/materialization-postgres-transactions.js": "./dist/features/contained-turn-access/adapters/outbound/postgres/materialization-postgres-transactions.js",
    "./dist/features/contained-turn-access/adapters/outbound/postgres/route-selection-data.js": "./dist/features/contained-turn-access/adapters/outbound/postgres/route-selection-data.js",
    "./dist/features/contained-turn-access/adapters/outbound/postgres/route-selection-schema.js": "./dist/features/contained-turn-access/adapters/outbound/postgres/route-selection-schema.js",
    "./dist/features/contained-turn-access/composition/postgres-credential-rendering-owner.js": "./dist/features/contained-turn-access/composition/postgres-credential-rendering-owner.js",
    "./dist/features/contained-turn-access/composition/postgres-operation-dispatch-consumption.js": "./dist/features/contained-turn-access/composition/postgres-operation-dispatch-consumption.js",
    "./dist/features/contained-turn-access/composition/route-selection-owner.js": "./dist/features/contained-turn-access/composition/route-selection-owner.js"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "pg": "catalog:"
  }
}
