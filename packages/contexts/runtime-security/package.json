{
  "name": "@agent-teams/runtime-security",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json --pretty false",
    "check": "pnpm run clean && pnpm run typecheck && pnpm run build && pnpm run test",
    "precheck": "pnpm --filter @agent-teams/filesystem-custody run build",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','.cache']) fs.rmSync(path, { recursive: true, force: true })\"",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "test:postgres": "node --import ./scripts/require-postgres-qualification.mjs --test --test-concurrency=1 tests/postgres-dispatch-durability.test.ts"
  },
  "agentTeamsArchitecture": {
    "role": "bounded-context",
    "ownerDocument": "ADR-0005"
  },
  "dependencies": {
    "@agent-teams/filesystem-custody": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./tests/contained-turn-dispatch-authority.fixtures.ts": "./tests/contained-turn-dispatch-authority.fixtures.ts",
    "./tests/postgres-dispatch.fixtures.ts": "./tests/postgres-dispatch.fixtures.ts",
    "./tests/provider-process-egress-authorization.fixtures.ts": "./tests/provider-process-egress-authorization.fixtures.ts",
    "./dist/features/contained-turn-dispatch-authority/adapters/outbound/postgres/dispatch-consumption-repository.js": "./dist/features/contained-turn-dispatch-authority/adapters/outbound/postgres/dispatch-consumption-repository.js",
    "./dist/features/contained-turn-dispatch-authority/composition/dispatch-acceptance-factory.js": "./dist/features/contained-turn-dispatch-authority/composition/dispatch-acceptance-factory.js",
    "./dist/features/provider-process-egress-authorization/application/egress-canonical.js": "./dist/features/provider-process-egress-authorization/application/egress-canonical.js",
    "./dist/features/provider-process-egress-authorization/composition/current-egress-validation.js": "./dist/features/provider-process-egress-authorization/composition/current-egress-validation.js"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "pg": "catalog:"
  }
}
