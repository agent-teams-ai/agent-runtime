{
  "name": "@agent-teams/embedded-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json --pretty false",
    "check": "node scripts/run-package-tests.mjs --check",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','.cache']) fs.rmSync(path, { recursive: true, force: true })\"",
    "test": "node scripts/run-package-tests.mjs",
    "test:joined:linux": "node scripts/run-linux-joined-product.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "test:http-completion": "node --experimental-test-module-mocks --test tests/support/linux-http-completion-negative.mjs"
  },
  "agentTeamsArchitecture": {
    "role": "host-app",
    "ownerDocument": "ADR-0008"
  },
  "dependencies": {
    "@agent-teams/agent-execution": "workspace:*",
    "@agent-teams/provider-access": "workspace:*",
    "@agent-teams/runtime-configuration": "workspace:*",
    "@agent-teams/runtime-security": "workspace:*",
    "@get-modular/assembly": "catalog:",
    "@get-modular/core": "catalog:"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    }
  },
  "devDependencies": {
    "pg": "catalog:"
  }
}
