{
  "extends": "./architecture/foundation/scaffold-tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2024",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "experiments/runtime-profile-behavior/src/**/*.ts",
    "experiments/runtime-profile-behavior/test/**/*.ts",
    "experiments/rust-system-boundaries/client/**/*.ts"
  ],
  "exclude": [
    "experiments/runtime-profile-behavior/src/features/evidence/generate-runtime-operation-oracle.ts",
    "experiments/runtime-profile-behavior/src/features/evidence/runtime-operation-xstate-builder.ts",
    "experiments/runtime-profile-behavior/test/runtime-operation-oracle.test.ts"
  ]
}
