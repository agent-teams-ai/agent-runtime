{
  "name": "@vioxen/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "check": "pnpm foundation:check && pnpm foundation:scaffold:check && pnpm docs:protocol:check && pnpm test:ar2-contract && pnpm architecture:runtime-setup-l0-evidence && pnpm architecture:registry && pnpm architecture:operation-oracle && pnpm product:check && pnpm typecheck && pnpm lint && pnpm test",
    "check:changed": "agent-teams-foundation agent-workflow changed --consumer .",
    "check:fast": "pnpm foundation:check && pnpm foundation:scaffold:check && pnpm docs:protocol:check && pnpm architecture:runtime-setup-l0-evidence && pnpm architecture:registry && pnpm architecture:operation-oracle && pnpm product:build && pnpm typecheck && pnpm lint",
    "docs:check": "agent-teams-docs check --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:doctor": "agent-teams-docs doctor --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:find": "agent-teams-docs find --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:governance": "node --test scripts/docs/verify-frozen-document-bytes.test.mjs",
    "docs:info": "agent-teams-docs info --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:new": "agent-teams-docs new --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "docs:protocol:check": "pnpm docs:check && pnpm docs:governance && pnpm docs:qualification",
    "docs:qualification": "node --test scripts/docs/docs-protocol-adoption.test.mjs",
    "docs:recover": "agent-teams-docs recover --consumer . --profile architecture/foundation/docs-protocol.yaml",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:check": "agent-teams-foundation check && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:status": "agent-teams-foundation status",
    "foundation:scaffold:plan": "agent-teams-foundation scaffold-plan --config architecture/foundation/scaffolding.yaml",
    "foundation:scaffold:check": "node scripts/foundation/verify-scaffolding.mjs",
    "foundation:scaffold:recover": "agent-teams-foundation scaffold-recover",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config .",
    "lint:changed": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config --format agent --no-error-on-unmatched-pattern",
    "product:build": "pnpm --filter './packages/**' -r run build",
    "product:check": "pnpm --filter './packages/**' -r run clean && pnpm product:build && pnpm --filter './packages/**' -r run test",
    "architecture:registry": "node experiments/runtime-profile-behavior/src/features/evidence/validate-qualification-registry.ts",
    "architecture:runtime-setup-l0-evidence": "node scripts/architecture/runtime-setup-l0-evidence.mjs --check",
    "architecture:runtime-setup-l0-evidence:capture": "node scripts/architecture/runtime-setup-l0-evidence.mjs --capture",
    "architecture:ar2-contract": "node scripts/architecture/validate-ar2-contract-artifacts.mjs",
    "test:ar2-contract": "node --test scripts/architecture/validate-ar2-contract-artifacts.test.mjs",
    "architecture:operation-oracle": "pnpm architecture:operation-oracle:type-generation && pnpm architecture:operation-oracle:property && pnpm architecture:operation-oracle:mutation && pnpm architecture:operation-oracle:model && node experiments/runtime-profile-behavior/src/features/evidence/validate-runtime-operation-oracle.ts",
    "architecture:operation-oracle:generate": "node experiments/runtime-profile-behavior/src/features/evidence/generate-runtime-operation-oracle.ts --write",
    "architecture:operation-oracle:generated": "node experiments/runtime-profile-behavior/src/features/evidence/generate-runtime-operation-oracle.ts --check",
    "architecture:operation-oracle:type-generation": "node experiments/runtime-profile-behavior/src/features/evidence/generate-runtime-operation-oracle.ts --check",
    "architecture:operation-oracle:property": "node --test experiments/runtime-profile-behavior/test/runtime-operation-oracle-properties.test.ts",
    "architecture:operation-oracle:mutation": "node --test experiments/runtime-profile-behavior/test/runtime-operation-oracle-mutation.test.ts",
    "architecture:operation-oracle:model": "node --test experiments/runtime-profile-behavior/test/runtime-operation-oracle-xstate.test.ts",
    "spike:inventory": "node experiments/runtime-profile-behavior/src/cli.ts inventory",
    "spike:baseline": "node experiments/runtime-profile-behavior/src/cli.ts baseline",
    "spike:precedence": "node experiments/runtime-profile-behavior/src/cli.ts precedence",
    "spike:stability": "node experiments/runtime-profile-behavior/src/cli.ts stability",
    "spike:credentials": "node experiments/runtime-profile-behavior/src/cli.ts credentials",
    "spike:e2e": "node experiments/runtime-profile-behavior/src/cli.ts e2e",
    "spike:lifecycle": "node experiments/runtime-profile-behavior/src/cli.ts lifecycle",
    "spike:acp": "node experiments/runtime-profile-behavior/src/cli.ts acp",
    "spike:filesystem": "node experiments/runtime-profile-behavior/src/cli.ts filesystem",
    "spike:drift": "node experiments/runtime-profile-behavior/src/cli.ts drift",
    "spike:binary": "node experiments/runtime-profile-behavior/src/cli.ts binary",
    "spike:legacy": "node experiments/runtime-profile-behavior/src/cli.ts legacy",
    "spike:extensions": "node experiments/runtime-profile-behavior/src/cli.ts extensions",
    "spike:profile-loss": "node experiments/runtime-profile-behavior/src/cli.ts profile-loss",
    "spike:managed-policy": "node experiments/runtime-profile-behavior/src/cli.ts managed-policy",
    "spike:promote-traces": "node experiments/runtime-profile-behavior/src/features/evidence/promote-redacted-traces.ts",
    "spike:rust-boundaries": "cargo test --locked --manifest-path experiments/rust-system-boundaries/Cargo.toml --workspace --all-targets",
    "spike:rust-boundaries:client": "node --test --test-concurrency=1 experiments/rust-system-boundaries/client/guardian-conformance.test.ts experiments/rust-system-boundaries/client/protocol-compat/v1-v2-compat.test.ts",
    "spike:rust-boundaries:evidence": "node --test experiments/runtime-profile-behavior/test/rust-system-boundary-evidence.test.ts",
    "test": "node --test --test-concurrency=1 experiments/runtime-profile-behavior/test/*.test.ts experiments/rust-system-boundaries/client/guardian-conformance.test.ts experiments/rust-system-boundaries/client/protocol-compat/v1-v2-compat.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false && tsc --project tsconfig.synthetic-oracle.json --noEmit --pretty false"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agent-teams/docs-protocol": "0.2.0",
    "@agent-teams/engineering-foundation": "0.20.0",
    "@agentclientprotocol/sdk": "catalog:",
    "@opencode-ai/plugin": "catalog:",
    "@types/node": "catalog:",
    "@xstate/graph": "catalog:",
    "ajv": "catalog:",
    "fast-check": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "jsonc-parser": "catalog:",
    "opencode-ai": "catalog:",
    "opencode-previous": "catalog:",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "xstate": "catalog:"
  }
}
