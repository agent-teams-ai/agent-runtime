{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "minimal-valid-feature-and-supported-syntax",
      "alphaRoles": ["contracts", "domain", "adapters"],
      "files": {
        "src/features/alpha/index.ts": "export type { PublicValue } from \"./contracts/public-value.js\";\n",
        "src/features/alpha/internal.ts": "export { value } from \"./domain/value.js\";\nexport { adapterValue } from \"./adapters/value.js\";\n",
        "src/features/alpha/contracts/public-value.ts": "export interface PublicValue { readonly value: string }\n",
        "src/features/alpha/domain/value.ts": "// import('../beta/domain/nope.js')\nconst text = \"require('../beta/domain/nope.js')\";\nexport interface Value { readonly value: string }\nexport const value = text;\n",
        "src/features/alpha/adapters/value.ts": "import fs = require('node:fs');\ntype External = import('node:fs').Stats;\nvoid import('node:path');\nexport const adapterValue = fs.constants.F_OK;\nvoid (null as unknown as External);\n",
        "src/index.ts": "export type { Value } from \"./features/alpha/index.js\";\n",
        "src/composition.ts": "export { value } from \"./features/alpha/internal.js\";\n"
      },
      "expected": []
    },
    {
      "name": "public-entrypoint-exposes-only-own-contracts",
      "files": {
        "src/features/alpha/index.ts": "export { value } from \"./domain/value.js\";\n"
      },
      "expected": [{ "code": "FM_PUBLIC_ENTRYPOINT_EXPORT", "path": "src/features/alpha/index.ts", "line": 1 }]
    },
    {
      "name": "behavior-outside-feature",
      "files": { "src/legacy.ts": "export const legacy = true;\n" },
      "expected": [{ "code": "FM_BEHAVIOR_OUTSIDE_FEATURE", "path": "src/legacy.ts", "line": 1 }]
    },
    {
      "name": "cross-feature-deep-import",
      "secondFeature": true,
      "secondRoles": ["domain", "adapters"],
      "edges": [{ "from": "beta", "to": "alpha", "kinds": ["runtime"] }],
      "files": { "src/features/beta/adapters/value.ts": "import { value } from \"../../alpha/domain/value.js\";\nexport const adapterValue = value;\n" },
      "expected": [{ "code": "FM_FEATURE_DEEP_IMPORT", "path": "src/features/beta/adapters/value.ts", "line": 1 }]
    },
    {
      "name": "undeclared-edge",
      "secondFeature": true,
      "secondRoles": ["domain", "adapters"],
      "files": { "src/features/beta/adapters/value.ts": "import { value } from \"../../alpha/index.js\";\nexport const adapterValue = value;\n" },
      "expected": [{ "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 1 }]
    },
    {
      "name": "unused-declared-edge-is-future-state-metadata",
      "secondFeature": true,
      "edges": [{ "from": "alpha", "to": "beta", "kinds": ["runtime"] }],
      "expected": [{ "code": "FM_UNUSED_EDGE", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "edge-must-reference-declared-features",
      "edges": [{ "from": "alpha", "to": "unknown", "kinds": ["runtime"] }],
      "expected": [{ "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "runtime-cycle",
      "secondFeature": true,
      "alphaRoles": ["domain", "adapters"],
      "secondRoles": ["domain", "adapters"],
      "edges": [
        { "from": "alpha", "to": "beta", "kinds": ["runtime"] },
        { "from": "beta", "to": "alpha", "kinds": ["runtime"] }
      ],
      "files": {
        "src/features/alpha/adapters/value.ts": "import { beta } from \"../../beta/index.js\";\nexport const adapterValue = beta;\n",
        "src/features/beta/adapters/value.ts": "import { value } from \"../../alpha/index.js\";\nexport const adapterBeta = value;\n"
      },
      "expected": [
        { "code": "FM_RUNTIME_CYCLE", "path": "src/features/alpha/adapters/value.ts", "line": 1 },
        { "code": "FM_RUNTIME_CYCLE", "path": "src/features/beta/adapters/value.ts", "line": 1 }
      ]
    },
    {
      "name": "type-only-cycle",
      "secondFeature": true,
      "alphaRoles": ["domain", "adapters"],
      "secondRoles": ["domain", "adapters"],
      "edges": [
        { "from": "alpha", "to": "beta", "kinds": ["type"] },
        { "from": "beta", "to": "alpha", "kinds": ["type"] }
      ],
      "files": {
        "src/features/alpha/adapters/value.ts": "import type { Beta } from \"../../beta/index.js\";\nexport interface AlphaAdapter { beta: Beta }\n",
        "src/features/beta/adapters/value.ts": "import type { Value } from \"../../alpha/index.js\";\nexport interface BetaAdapter { value: Value }\n"
      },
      "expected": [
        { "code": "FM_TYPE_CYCLE", "path": "src/features/alpha/adapters/value.ts", "line": 1 },
        { "code": "FM_TYPE_CYCLE", "path": "src/features/beta/adapters/value.ts", "line": 1 }
      ]
    },
    {
      "name": "empty-ceremonial-layer",
      "alphaRoles": ["domain", "application"],
      "files": { "src/features/alpha/application/placeholder.ts": "// later\nexport { value } from '../domain/value.js';\n" },
      "expected": [{ "code": "FM_EMPTY_LAYER", "path": "src/features/alpha/application", "line": 1 }]
    },
    {
      "name": "undeclared-module-and-ownership",
      "files": {
        "src/features/alpha/helpers/tool.ts": "export const tool = true;\n",
        "src/shared/value.ts": "export const shared = true;\n"
      },
      "expected": [
        { "code": "FM_UNDECLARED_MODULE", "path": "src/features/alpha/helpers/tool.ts", "line": 1 },
        { "code": "FM_UNDECLARED_OWNERSHIP", "path": "src/shared/value.ts", "line": 1 }
      ]
    },
    {
      "name": "invalid-layer-direction",
      "alphaRoles": ["domain", "application"],
      "files": {
        "src/features/alpha/application/use.ts": "export const use = true;\n",
        "src/features/alpha/domain/value.ts": "import { use } from \"../application/use.js\";\nexport const value = use;\n"
      },
      "expected": [{ "code": "FM_INVALID_LAYER_DIRECTION", "path": "src/features/alpha/domain/value.ts", "line": 1 }]
    },
    {
      "name": "domain-cannot-import-public-contracts",
      "alphaRoles": ["contracts", "domain"],
      "files": {
        "src/features/alpha/contracts/public.ts": "export interface PublicContract { readonly value: string }\n",
        "src/features/alpha/domain/value.ts": "import type { PublicContract } from \"../contracts/public.js\";\nexport const value: PublicContract = { value: 'domain' };\n"
      },
      "expected": [{ "code": "FM_INVALID_LAYER_DIRECTION", "path": "src/features/alpha/domain/value.ts", "line": 1 }]
    },
    {
      "name": "application-cannot-import-public-contracts",
      "alphaRoles": ["contracts", "domain", "application"],
      "files": {
        "src/features/alpha/contracts/public.ts": "export interface PublicContract { readonly value: string }\n",
        "src/features/alpha/application/use.ts": "import type { PublicContract } from \"../contracts/public.js\";\nexport const use = (value: PublicContract): string => value.value;\n"
      },
      "expected": [{ "code": "FM_INVALID_LAYER_DIRECTION", "path": "src/features/alpha/application/use.ts", "line": 1 }]
    },
    {
      "name": "application-cannot-import-another-feature-public-contract",
      "alphaRoles": ["domain", "application"],
      "secondFeature": true,
      "edges": [{ "from": "alpha", "to": "beta", "kinds": ["type"] }],
      "files": {
        "src/features/alpha/application/use.ts": "import type { Beta } from \"../../beta/index.js\";\nexport interface Use { readonly beta: Beta }\n"
      },
      "expected": [{ "code": "FM_INVALID_LAYER_DIRECTION", "path": "src/features/alpha/application/use.ts", "line": 1 }]
    },
    {
      "name": "invalid-authority",
      "authorityId": "mutable.local-standard",
      "expected": [{ "code": "FM_INVALID_AUTHORITY", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "authority-rejects-undeclared-fields",
      "authorityExtra": { "mutableRef": "main" },
      "expected": [{ "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "future-state-metadata",
      "profileExtra": { "futureState": { "automaticallyWiden": true } },
      "expected": [{ "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "wildcard-exception",
      "exceptions": [{ "id": "all", "acceptedAdr": "ADR-0007", "owner": "architecture", "rationale": "temporary", "reviewTrigger": "packages/**" }],
      "expected": [{ "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "ownership-exception-requires-accepted-adr",
      "exceptions": [{ "id": "shared-owner", "acceptedAdr": "ADR-0013", "owner": "architecture", "rationale": "temporary", "reviewTrigger": "src/shared/value.ts" }],
      "expected": [{ "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "candidate-requires-explicit-blockers",
      "activation": { "blockers": [], "acceptance": ["zero diagnostics"], "authority": null, "evidence": null },
      "expected": [{ "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "active-requires-zero-blockers-and-accepted-authority-evidence",
      "status": "active",
      "activation": { "blockers": ["not clean"], "acceptance": ["zero diagnostics"], "authority": { "acceptedAdr": "ADR-0013", "owner": "architecture" }, "evidence": null },
      "expected": [
        { "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 },
        { "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }
      ]
    },
    {
      "name": "require-active-rejects-candidate-profile",
      "requiredStatus": "active",
      "expected": [{ "code": "FM_PROFILE_STATUS", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "active-profile-with-accepted-authority-and-evidence",
      "status": "active",
      "requiredStatus": "active",
      "expected": []
    },
    {
      "name": "active-profile-rejects-proposed-authority",
      "status": "active",
      "activation": { "blockers": [], "acceptance": ["zero diagnostics"], "authority": { "acceptedAdr": "ADR-0013", "owner": "architecture" }, "evidence": { "fixtureCommand": "pnpm test:feature-modules", "candidateCommand": "pnpm architecture:feature-modules:candidate", "productionDiagnostics": 0 } },
      "expected": [{ "code": "FM_PROFILE_INVALID", "path": "profile.json", "line": 1 }]
    },
    {
      "name": "package-index-must-use-public-entrypoint",
      "files": { "src/index.ts": "export { value } from './features/alpha/internal.js';\n" },
      "expected": [{ "code": "FM_FEATURE_DEEP_IMPORT", "path": "src/index.ts", "line": 1 }]
    },
    {
      "name": "package-composition-must-use-internal-entrypoint",
      "files": { "src/composition.ts": "export { value } from './features/alpha/index.js';\n" },
      "expected": [{ "code": "FM_FEATURE_DEEP_IMPORT", "path": "src/composition.ts", "line": 1 }]
    },
    {
      "name": "package-assembly-rejects-non-feature-target",
      "files": { "src/index.ts": "export { legacy } from './legacy.js';\n" },
      "expected": [{ "code": "FM_ASSEMBLY_IMPORT_TARGET", "path": "src/index.ts", "line": 1 }]
    },
    {
      "name": "package-assembly-rejects-inline-behavior",
      "files": { "src/composition.ts": "export const compose = () => true;\n" },
      "expected": [{ "code": "FM_INLINE_BEHAVIOR", "path": "src/composition.ts", "line": 1 }]
    },
    {
      "name": "feature-entrypoint-rejects-inline-behavior",
      "files": { "src/features/alpha/internal.ts": "export const value = true;\n" },
      "expected": [{ "code": "FM_INLINE_BEHAVIOR", "path": "src/features/alpha/internal.ts", "line": 1 }]
    },
    {
      "name": "feature-rejects-undeclared-local-dependency",
      "files": { "src/features/alpha/domain/value.ts": "import type { Legacy } from '../../../legacy.js';\nexport type Value = Legacy;\n" },
      "expected": [{ "code": "FM_UNDECLARED_LOCAL_DEPENDENCY", "path": "src/features/alpha/domain/value.ts", "line": 1 }]
    },
    {
      "name": "domain-rejects-node-builtins",
      "files": { "src/features/alpha/domain/value.ts": "import type { Stats } from 'node:fs';\nexport type Value = Stats;\n" },
      "expected": [{ "code": "FM_NODE_BUILTIN_IMPORT", "path": "src/features/alpha/domain/value.ts", "line": 1 }]
    },
    {
      "name": "contracts-reject-external-packages",
      "alphaRoles": ["contracts", "domain"],
      "files": { "src/features/alpha/contracts/public.ts": "import type { Schema } from 'external-schema';\nexport type Public = Schema;\n" },
      "expected": [{ "code": "FM_EXTERNAL_IMPORT", "path": "src/features/alpha/contracts/public.ts", "line": 1 }]
    },
    {
      "name": "application-rejects-external-packages",
      "alphaRoles": ["domain", "application"],
      "files": { "src/features/alpha/application/use.ts": "import type { Schema } from 'external-schema';\nexport type Use = Schema;\n" },
      "expected": [{ "code": "FM_EXTERNAL_IMPORT", "path": "src/features/alpha/application/use.ts", "line": 1 }]
    },
    {
      "name": "path-alias-cannot-bypass-feature-boundary",
      "alphaRoles": ["domain", "adapters"],
      "files": { "src/features/alpha/adapters/value.ts": "import { value } from '@/features/alpha/domain/value.js';\nexport const adapterValue = value;\n" },
      "expected": [{ "code": "FM_PATH_ALIAS_IMPORT", "path": "src/features/alpha/adapters/value.ts", "line": 1 }]
    },
    {
      "name": "package-self-import-cannot-bypass-feature-boundary",
      "alphaRoles": ["domain", "adapters"],
      "files": { "src/features/alpha/adapters/value.ts": "import { value } from '@fixture/runtime';\nexport const adapterValue = value;\n" },
      "expected": [{ "code": "FM_UNDECLARED_LOCAL_DEPENDENCY", "path": "src/features/alpha/adapters/value.ts", "line": 1 }]
    },
    {
      "name": "comments-and-strings-versus-real-syntax",
      "secondFeature": true,
      "secondRoles": ["domain", "adapters"],
      "files": {
        "src/features/beta/adapters/value.ts": "// import { value } from '../../alpha/index.js';\nconst sample = \"require('../../alpha/index.js')\";\nexport { value } from \"../../alpha/index.js\";\nexport { sample };\n"
      },
      "expected": [{ "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 3 }]
    },
    {
      "name": "all-import-and-reexport-syntax-is-enforced",
      "secondFeature": true,
      "secondRoles": ["domain", "adapters"],
      "files": {
        "src/features/beta/adapters/value.ts": "import { value } from \"../../alpha/index.js\";\nexport { value as exportedValue } from \"../../alpha/index.js\";\nexport const load = () => import(\"../../alpha/index.js\");\nexport type Imported = import(\"../../alpha/index.js\").Value;\nimport Alpha = require(\"../../alpha/index.js\");\nexport const required = require(\"../../alpha/index.js\");\nvoid value; void Alpha;\n"
      },
      "expected": [
        { "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 1 },
        { "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 2 },
        { "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 3 },
        { "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 4 },
        { "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 5 },
        { "code": "FM_UNDECLARED_EDGE", "path": "src/features/beta/adapters/value.ts", "line": 6 }
      ]
    },
    {
      "name": "nonliteral-loading",
      "files": { "src/features/alpha/domain/value.ts": "const target = './other.js';\nexport const value = import(target);\n" },
      "expected": [{ "code": "FM_NONLITERAL_LOADING", "path": "src/features/alpha/domain/value.ts", "line": 2 }]
    },
    {
      "name": "parse-failure",
      "files": { "src/features/alpha/domain/value.ts": "export const value = ;\n" },
      "expected": [{ "code": "FM_PARSE_FAILURE", "path": "src/features/alpha/domain/value.ts", "line": 1 }]
    }
  ]
}
