{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-runtime://architecture/legacy-feature-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "agentRuntimeCommit", "legacyCommit", "items"],
  "properties": {
    "$schema": { "const": "./legacy-feature-inventory.schema.json" },
    "schemaVersion": { "const": 1 },
    "agentRuntimeCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "legacyCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "provider", "userJob", "userValue", "legacyBehavior", "exactLegacyEvidence", "failureAndEdgeCases", "reuseDecision", "newOwner", "proposedDisposition", "authorityStatus", "acceptanceEvidence", "futureExtensionSeam"],
        "properties": {
          "capabilityId": { "type": "string", "minLength": 1 },
          "provider": { "enum": ["codex", "claude-code", "opencode"] },
          "userJob": { "type": "string", "minLength": 1 },
          "userValue": { "type": "string", "minLength": 1 },
          "legacyBehavior": { "type": "string", "minLength": 1 },
          "exactLegacyEvidence": { "type": "string", "minLength": 1 },
          "failureAndEdgeCases": { "type": "string", "minLength": 1 },
          "reuseDecision": { "enum": ["reuse_fixture", "reuse_concept", "refactor_pattern", "keep_provider_specific", "reject_legacy_approach"] },
          "newOwner": { "type": "string", "minLength": 1 },
          "proposedDisposition": { "enum": ["approved_now", "recommended_next", "recommended_later", "rejected", "needs_owner"] },
          "authorityStatus": { "type": "string", "minLength": 1 },
          "acceptanceEvidence": { "type": "string", "minLength": 1 },
          "futureExtensionSeam": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
