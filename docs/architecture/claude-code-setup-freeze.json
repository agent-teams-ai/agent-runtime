  },
  "strictJson": {
    "encoding": "utf-8",
    "root": "object",
    "reject": ["bom", "comments", "trailing-commas", "duplicate-keys-at-any-depth", "invalid-utf8", "non-object-root"]
  },
  "routeCategories": ["provider-selector", "skip-auth-selector", "endpoint", "cloud-location-account", "model-routing-remap", "credential-reference", "executable-credential-helper"],
  "secretCategories": ["direct-secret", "cloud-secret", "oauth-token", "custom-header", "private-key", "password", "credential", "secret-shaped-name", "secret-shaped-value"],
