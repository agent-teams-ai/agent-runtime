{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification-registry.schema.json",
  "title": "Agent Runtime qualification registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "matchingPolicy",
    "qualificationLevels",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "./qualification-registry.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date"
    },
    "matchingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "dimensionRule",
        "entryValueRule",
        "wildcardsAllowed",
        "promotionRule"
      ],
      "properties": {
        "default": {
          "const": "unqualified"
        },
        "dimensionRule": {
          "const": "exact-match-whole-target-tuple"
        },
        "entryValueRule": {
          "const": "each-target-is-one-complete-observed-scalar-tuple"
        },
        "wildcardsAllowed": {
          "const": false
        },
        "promotionRule": {
          "const": "explicit-evidence-and-readiness-update"
        }
      }
    },
    "qualificationLevels": {
      "type": "array",
      "const": [
        "unqualified",
        "scoped",
        "implementation",
        "deployment"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "exactToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:\\*|[Aa][Nn][Yy]|[Aa][Ll][Ll])$).+"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "providerAdapter",
        "binaryClosure",
        "platform",
        "credentialRoute",
        "storageTopology",
        "transportTopology",
        "failureDomain"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/exactToken"
        },
        "providerAdapter": {
          "$ref": "#/$defs/exactToken"
        },
        "binaryClosure": {
          "$ref": "#/$defs/exactToken"
        },
        "platform": {
          "$ref": "#/$defs/exactToken"
        },
        "credentialRoute": {
          "$ref": "#/$defs/exactToken"
        },
        "storageTopology": {
          "$ref": "#/$defs/exactToken"
        },
        "transportTopology": {
          "$ref": "#/$defs/exactToken"
        },
        "failureDomain": {
          "$ref": "#/$defs/exactToken"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human-report",
            "redacted-summary"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(docs/spikes/|experiments/runtime-profile-behavior/fixtures/).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "qualification",
        "targets",
        "evidence",
        "readinessSections",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "qualification": {
          "enum": [
            "unqualified",
            "scoped",
            "implementation",
            "deployment"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "readinessSections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
