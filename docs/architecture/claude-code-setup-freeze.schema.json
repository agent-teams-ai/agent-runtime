{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-runtime://architecture/claude-code-setup-freeze.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractId", "snapshot", "dialect", "platform", "entryPoint", "sourceModel", "portableIntent", "routeVocabulary", "strictJson", "expectedLimitations", "diagnostics", "diagnosticRedaction", "budgets", "resultSemantics", "fixtureMatrix"],
  "properties": {
    "$schema": { "const": "./claude-code-setup-freeze.schema.json" },
    "schemaVersion": { "const": 2 },
    "contractId": { "const": "ar-2-claude-code-setup-preview@2" },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "semanticArtifact", "documents"],
      "properties": {
        "date": { "const": "2026-08-28" },
        "semanticArtifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "docs/architecture/claude-code-official-semantics.snapshot.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "documents": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/snapshotDocument" } }
      }
    },
    "dialect": { "const": {
      "id": "claude-code-settings@2026-08-28",
      "qualifiesExecutable": false,
      "statement": "This dialect identifies frozen documented file semantics only and does not qualify, version, or establish compatibility of any executable."
    } },
    "platform": { "const": "darwin" },
    "entryPoint": { "const": {
      "member": "RuntimeAccessHandle.claudeCodeSetup.inspect", "productInput": "none", "cancellation": "options.signal"
    } },
    "sourceModel": { "const": {
      "contract": "claude-code-observed-source-plan/v1", "claim": "observed-files-only",
      "hostComposed": ["collector", "custodyRoots", "sourcePaths", "sourceIds", "rootIds", "roles", "trust", "selectionBases"],
      "staticPreviewSelectionBasis": "static-preview", "precedence": "not-evaluated", "compatibility": "unqualified",
      "arrayOrder": "presentation-only", "malformedIsolation": "one malformed source does not suppress an unrelated source",
      "forbiddenDiscovery": ["process.cwd", "process.env.CLAUDE_CONFIG_DIR", "git-discovery", "binary-revision-inference", "arbitrary-caller-ranks"]
    } },
    "portableIntent": { "const": {
      "keys": ["model", "effortLevel"], "modelDefault": "default",
      "modelAliases": ["best", "fable", "sonnet", "opus", "haiku", "sonnet[1m]", "opus[1m]", "opusplan"],
      "exactNameSyntax": "^claude-[a-z0-9]+(?:-[a-z0-9]+)*(?:\\[1m\\])?$",
      "exactNameClaim": "syntax-only intent; catalog presence, provider interpretation, and compatibility remain unobserved",
      "deferredModelForms": ["provider-deployment", "unclassified-selector"], "deferredObservation": "value-free",
      "modelCompatibility": "unobserved", "effortValues": ["low", "medium", "high", "xhigh"],
      "resolution": "Every declared file is parsed independently and emits source-bound observations; no cross-source winner or effective configuration is selected."
    } },
    "routeVocabulary": { "const": {
      "revision": "claude-code-provider-route-vocabulary/v2",
      "ownership": "Provider Access future route/account binding",
      "retainedBedrockKeys": ["CLAUDE_CODE_USE_BEDROCK", "AWS_REGION", "AWS_DEFAULT_REGION", "ANTHROPIC_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL", "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL", "ANTHROPIC_BEDROCK_REGION_PREFIX", "ANTHROPIC_BEDROCK_SERVICE_TIER", "CLAUDE_CODE_USE_MANTLE", "CLAUDE_CODE_SKIP_MANTLE_AUTH", "ANTHROPIC_BEDROCK_MANTLE_BASE_URL"],
      "redaction": "category-only; no raw route value, account, endpoint, deployment, hash, length, or value-derived reference"
    } },
    "strictJson": { "const": {
      "encoding": "utf-8", "root": "object",
      "reject": ["bom", "comments", "trailing-commas", "duplicate-keys-at-any-depth", "invalid-utf8", "non-object-root"]
    } },
    "expectedLimitations": { "const": {
      "managedPolicy": "unobserved", "sessionOverrides": "unobserved", "interactiveShellPath": "unobserved",
      "modelCompatibility": "unobserved", "executableCompatibility": "unqualified", "precedence": "not-evaluated"
    } },
    "diagnostics": { "const": [
      "candidate_denied", "candidate_invalid", "candidate_unreadable", "candidate_unstable",
      "configuration_dialect_unsupported", "config_duplicate_key", "config_invalid_utf8", "config_parse_failed",
      "config_too_large", "config_unreadable", "credential_material_rejected", "provider_route_deferred",
      "secret_setting_rejected", "setting_type_unsupported", "setting_value_unsupported", "source_epoch_stale",
      "source_inventory_overflow", "source_plan_invalid", "source_plan_unsupported", "source_total_too_large",
      "source_untrusted", "unsupported_platform"
    ] },
    "diagnosticRedaction": { "const": ["values", "unknown-key-names", "raw-paths", "raw-parser-snippets", "raw-os-errors", "raw-file-digests", "route-ids", "credentials", "length-derived-references"] },
    "budgets": { "const": {
      "bytesPerSource": 131072, "aggregateSourceBytes": 1048576, "depth": 16, "nodes": 4096,
      "objectKeys": 1024, "arrayItems": 1024, "keyLength": 256, "stringLength": 16384,
      "classifierValueLength": 256, "identifierLength": 128, "pathLength": 16384,
      "sourceSlots": 16, "rootSlots": 16, "locationClaimsPerSource": 4,
      "explicitPaths": 16, "suppliedPathEntries": 64, "totalCandidates": 256, "diagnostics": 1024
    } },
    "resultSemantics": { "const": {
      "sections": ["installations", "observedPortableIntent", "deferredObservations", "sourceModel", "sourceObservations", "expectedLimitations", "diagnostics", "nextActions"],
      "statuses": ["observed", "partial", "denied", "unsupported"], "installationStatus": "found_unverified",
      "partial": "Only an actual failure in the bounded declared observation causes partial. A valid deferred model or an expected limitation does not.",
      "absence": "A clean absent installation is observed and includes install_claude_code as a next action.",
      "provenance": "Opaque references bind topology, collector, dialect, classifier revision, and ordered source observations without raw paths or file digests.",
      "futureHandoff": ["qualified-topology-dialect", "ProfileDraft", "ProfileRevision"],
      "detached": true, "deepFrozen": true, "deterministic": true
    } },
    "fixtureMatrix": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/$defs/fixtureCase" } }
  },
  "$defs": {
    "snapshotDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "url", "rawResponseSha256", "artifactPath"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "url": { "type": "string", "pattern": "^https://" },
        "rawResponseSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifactPath": { "type": "string", "pattern": "^docs/architecture/evidence/claude-code-settings-semantics-2026-08-28/[a-z0-9.-]+\\.gz$" }
      }
    },
    "fixtureCase": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["id", "expected"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "expected": { "type": "string", "pattern": "^[a-z0-9-]+$" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "diagnostic"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "diagnostic": { "type": "string", "pattern": "^[a-z0-9_]+$" } } }
      ]
    }
  }
}
