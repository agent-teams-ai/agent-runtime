{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-runtime://architecture/claude-code-setup-freeze.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractId", "snapshot", "dialect", "platform", "entryPoint", "trustedScope", "candidateOrder", "sources", "precedenceHighToLow", "portableIntent", "strictJson", "routeCategories", "secretCategories", "expectedLimitations", "diagnostics", "diagnosticRedaction", "budgets", "resultSemantics", "fixtureMatrix"],
  "properties": {
    "$schema": { "const": "./claude-code-setup-freeze.schema.json" },
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "ar-2-claude-code-setup-preview@1" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "semanticArtifact", "documents"],
      "properties": {
        "date": { "const": "2026-08-28" },
        "semanticArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "docs/architecture/claude-code-official-semantics.snapshot.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "documents": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/settings.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/settings-reference.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/model-config.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/setup.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/managed-settings.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/authentication.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/env-vars.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/claude-directory.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/amazon-bedrock.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/google-vertex-ai.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/microsoft-foundry.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://code.claude.com/docs/en/llm-gateway-connect.md" } } },
            { "$ref": "#/$defs/snapshotDocument", "properties": { "url": { "const": "https://json.schemastore.org/claude-code-settings.json" } } }
          ],
          "items": false
        }
      }
    },
    "dialect": { "const": { "id": "claude-code-settings@2026-08-28", "qualifiesExecutable": false, "statement": "This dialect identifies frozen documented file semantics only and does not qualify, version, or establish compatibility of any executable." } },
    "platform": { "const": "darwin" },
    "entryPoint": { "const": { "member": "RuntimeAccessHandle.claudeCodeSetup.inspect", "productInput": "none", "cancellation": "options.signal" } },
    "trustedScope": { "const": { "supplied": ["explicitExecutablePaths", "pathEntries", "dialect", "homeRoot", "workspaceRoot", "workspaceTrusted"], "derivedInComposition": ["userSourcePath", "sharedProjectSourcePath", "projectLocalSourcePath", "knownExecutablePaths"], "forbiddenAmbientInputs": ["process.env", "process.cwd", "interactiveShellPath", "CLAUDE_CONFIG_DIR"] } },
    "candidateOrder": { "const": ["explicit-paths", "supplied-path-entries", "~/.local/bin/claude", "/opt/homebrew/bin/claude", "/usr/local/bin/claude"] },
    "sources": { "const": [{ "kind": "user", "rank": 1, "pathTemplate": "~/.claude/settings.json" }, { "kind": "shared-project", "rank": 2, "pathTemplate": "<workspace>/.claude/settings.json" }, { "kind": "project-local", "rank": 3, "pathTemplate": "<workspace>/.claude/settings.local.json" }] },
    "precedenceHighToLow": { "const": ["project-local", "shared-project", "user"] },
    "portableIntent": { "const": { "keys": ["model", "effortLevel"], "modelAliases": ["default", "best", "fable", "sonnet", "opus", "haiku", "sonnet[1m]", "opus[1m]", "opusplan"], "effortValues": ["low", "medium", "high", "xhigh"], "resolution": "For each key, return the highest valid file value only when every higher source proves absence or validity. Malformed, unreadable, stale, or untrusted higher sources taint lower resolution. An invalid, secret-shaped, or route-shaped higher definition taints that key.", "legacyMax": "rejected" } },
    "strictJson": { "const": { "encoding": "utf-8", "root": "object", "reject": ["bom", "comments", "trailing-commas", "duplicate-keys-at-any-depth", "invalid-utf8", "non-object-root"] } },
    "routeCategories": { "const": ["provider-selector", "skip-auth-selector", "endpoint", "cloud-location-account", "model-routing-remap", "credential-reference", "executable-credential-helper"] },
    "secretCategories": { "const": ["direct-secret", "cloud-secret", "oauth-token", "custom-header", "private-key", "password", "credential", "secret-shaped-name", "secret-shaped-value"] },
    "expectedLimitations": { "const": { "managedPolicy": "unobserved", "sessionOverrides": "unobserved", "interactiveShellPath": "unobserved" } },
    "diagnostics": { "const": ["candidate_denied", "candidate_invalid", "candidate_unreadable", "candidate_unstable", "configuration_dialect_unsupported", "config_duplicate_key", "config_invalid_utf8", "config_parse_failed", "config_too_large", "config_unreadable", "credential_material_rejected", "provider_route_deferred", "secret_setting_rejected", "setting_type_unsupported", "setting_value_unsupported", "source_untrusted", "source_epoch_stale", "unsupported_platform"] },
    "diagnosticRedaction": { "const": ["values", "unknown-key-names", "raw-paths", "raw-parser-snippets", "raw-os-errors", "raw-file-digests", "route-ids", "credentials"] },
    "budgets": { "const": { "bytesPerSource": 131072, "depth": 16, "nodes": 4096, "objectKeys": 1024, "arrayItems": 1024, "keyLength": 256, "stringLength": 16384, "classifierValueLength": 256, "sourceSlots": 3, "explicitPaths": 16, "suppliedPathEntries": 64, "totalCandidates": 256, "diagnostics": 1024 } },
    "resultSemantics": { "const": { "sections": ["installations", "portableIntent", "sourceObservations", "expectedLimitations", "diagnostics", "nextActions"], "statuses": ["observed", "partial", "denied", "unsupported"], "installationStatus": "found_unverified", "partial": "Only actual degradation of the declared V1 scope. Expected limitations, a clean absent optional setting, or no installation do not cause partial.", "absence": "A clean absent installation is observed and includes install_claude_code as a next action.", "detached": true, "deepFrozen": true, "deterministic": true } },
    "fixtureMatrix": { "type": "array", "minItems": 21, "maxItems": 21, "items": { "$ref": "#/$defs/fixtureCase" } }
  },
  "$defs": {
    "snapshotDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": { "url": { "type": "string", "pattern": "^https://" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "fixtureCase": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["id", "expected"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "expected": { "type": "string", "pattern": "^[a-z0-9-]+$" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "diagnostic"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "diagnostic": { "type": "string", "pattern": "^[a-z0-9_]+$" } } }
      ]
    }
  }
}
